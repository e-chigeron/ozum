#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

required_paths=(
  AGENTS.md
  specs/README.md
  scripts/verify-project
  devenv.nix
  devenv.yaml
  orca.yaml
)

for path in "${required_paths[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'missing required path: %s\n' "$path" >&2
    exit 1
  fi
done

shopt -s nullglob globstar
intent_files=(Intent/**/*.md)
has_intent=false
for intent_file in "${intent_files[@]}"; do
  if grep -q '[^[:space:]]' "$intent_file"; then
    has_intent=true
    break
  fi
done
if [[ "$has_intent" != true ]]; then
  printf 'Intent/ must contain a non-empty Markdown file\n' >&2
  exit 1
fi

nix-instantiate --parse devenv.nix >/dev/null
shellcheck scripts/verify-project

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git diff --check
fi

# プロジェクト導入時に製品固有のbuild・test・lintを追加する。
printf 'project scaffold checks passed (product build/test/lint not configured)\n'
