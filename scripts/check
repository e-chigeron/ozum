#!/usr/bin/env bash
set -euo pipefail

harness_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$harness_root"

required_paths=(
  AGENTS.md
  README.md
  profiles/codex/AGENTS.md
  skills/develop-from-intent/SKILL.md
  skills/change-intent/SKILL.md
  skills/review-dev-method/SKILL.md
  templates/project/AGENTS.md
  templates/project/specs/README.md
  templates/project/scripts/verify-project
  templates/project/devenv.nix
  templates/project/devenv.yaml
  templates/project/orca.yaml
  scripts/check
  devenv.nix
  devenv.yaml
  orca.yaml
)

for path in "${required_paths[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'missing required path: %s\n' "$path" >&2
    exit 1
  fi
done

shopt -s nullglob globstar
intent_files=(Intent/**/*.md)
has_intent=false
for intent_file in "${intent_files[@]}"; do
  if grep -q '[^[:space:]]' "$intent_file"; then
    has_intent=true
    break
  fi
done
if [[ "$has_intent" != true ]]; then
  printf 'Intent/ must contain a non-empty Markdown file\n' >&2
  exit 1
fi

for skill in develop-from-intent change-intent review-dev-method; do
  skill_file="skills/$skill/SKILL.md"
  if ! grep -Fqx "name: $skill" "$skill_file"; then
    printf 'skill name does not match directory: %s\n' "$skill_file" >&2
    exit 1
  fi
done

sync_rule='- 依頼・承認されたcommitは、明示的なlocal-only指定がなければ検証後に設定済みupstreamへpushする。remote、認証、対象branchを推測せず、失敗は未同期として報告する。'
for instructions in AGENTS.md profiles/codex/AGENTS.md templates/project/AGENTS.md; do
  if ! grep -Fqx -- "$sync_rule" "$instructions"; then
    printf 'missing upstream sync rule: %s\n' "$instructions" >&2
    exit 1
  fi
done

nix-instantiate --parse devenv.nix >/dev/null
nix-instantiate --parse templates/project/devenv.nix >/dev/null
shellcheck scripts/check templates/project/scripts/verify-project
bash templates/project/scripts/verify-project
git diff --check

printf 'harness verification passed\n'
