#!/usr/bin/env bash
set -euo pipefail

harness_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

packet="$test_root/handoff.aictx"
invalid_packet="$test_root/invalid.aictx"

"$harness_root/scripts/aictx" init "$packet"
"$harness_root/scripts/aictx" validate "$packet" >/dev/null

meta_output="$("$harness_root/scripts/aictx" meta "$packet")"
grep -Fq '"key":"format","value":"aictx"' <<<"$meta_output"
grep -Fq '"key":"schema_version","value":"0"' <<<"$meta_output"

sqlite3 -bail "$packet" <<'SQL'
PRAGMA foreign_keys = ON;
INSERT INTO nodes (id, kind, body, priority) VALUES
  ('I1', 'intent', 'Keep durable knowledge in repositories', 100),
  ('T1', 'task', 'Improve the method', 80),
  ('C1', 'constraint', 'Keep the handoff temporary', 90),
  ('U1', 'task', 'Unrelated task', 10);
INSERT INTO edges (src, rel, dst) VALUES
  ('T1', 'implements', 'I1'),
  ('C1', 'constrains', 'I1');
INSERT INTO entrypoints (node_id, rank) VALUES ('T1', 1);
SQL

entrypoint_output="$("$harness_root/scripts/aictx" entrypoints "$packet")"
grep -Fq '"id":"T1"' <<<"$entrypoint_output"

expand_output="$("$harness_root/scripts/aictx" expand "$packet")"
grep -Fq '"id":"I1"' <<<"$expand_output"
grep -Fq '"id":"C1"' <<<"$expand_output"
grep -Fq '"src":"C1","rel":"constrains","dst":"I1"' <<<"$expand_output"
if grep -Fq '"id":"U1"' <<<"$expand_output"; then
  printf 'expand included a node disconnected from the entrypoints\n' >&2
  exit 1
fi

cp "$packet" "$invalid_packet"
sqlite3 -bail "$invalid_packet" \
  "PRAGMA foreign_keys = OFF; INSERT INTO edges (src, rel, dst) VALUES ('missing', 'blocks', 'T1');"
if "$harness_root/scripts/aictx" validate "$invalid_packet" >/dev/null 2>&1; then
  printf 'validation accepted a foreign-key violation\n' >&2
  exit 1
fi

if "$harness_root/scripts/aictx" init "$packet" >/dev/null 2>&1; then
  printf 'init replaced an existing packet\n' >&2
  exit 1
fi

printf 'aictx tests passed\n'
